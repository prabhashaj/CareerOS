{
  "manifest_version": 3,
  "name": "CareerOS AI & CDP Agent",
  "version": "0.2.0",
  "description": "Auto-apply to jobs using local Chrome DevTools Protocol (CDP), tailored resumes, and knowledge base answers.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "debugger",
    "downloads"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png",
    "default_title": "CareerOS Agent"
  },
  "background": { "service_worker": "background.js" },
  "icons": { "48": "icon.png", "128": "icon.png" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    { "resources": ["popup.html"], "matches": ["<all_urls>"] }
  ]
}
