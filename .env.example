# =============================================================================
# CareerOS Environment Configuration
# =============================================================================

# --- Supabase (Required) ------------------------------------------------------
# Your Supabase project URL and keys from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-public-key"

# Client-side Supabase keys (prefixed for Vite SSR / frontend)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-public-key"

# Optional: Supabase Service Role Key (for admin tasks)
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"


# --- AI Intelligence (Required for AI features) ------------------------------
# Powers resume tailoring, cover letter generation, job ranking, and candidate evaluation.
# Get your API key from: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY="your-mistral-api-key"


# --- Web Job Search & ATS Scraping (Optional) --------------------------------
# Job search works out-of-the-box using free public aggregators (Remotive, Arbeitnow,
# The Muse, Jobicy, RemoteOK). Setting TAVILY_API_KEY enables deep web searching
# across company ATS boards (Greenhouse, Lever, Ashby, Workday) and Indian portals (Naukri, LinkedIn, Cutshort).
# Get your API key from: https://tavily.com
TAVILY_API_KEY=""


# --- Web Page Ingestion & Profile Import (Optional) --------------------------
# Enables direct URL extraction of job descriptions and LinkedIn/GitHub profiles.
# Get your API key from: https://firecrawl.dev
FIRECRAWL_API_KEY=""


# --- Cloud Browser Automation (Optional) -------------------------------------
# Used for live browser autofill and guided application submission sessions.
# Get your keys from: https://browserbase.com
BROWSERBASE_API_KEY=""
BROWSERBASE_PROJECT_ID=""


# --- Embeddings Fallback (Optional) ------------------------------------------
# Hugging Face token for alternative embedding models.
# HF_TOKEN=""
